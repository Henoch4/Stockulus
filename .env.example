# Stockulus environment — copy to .env and fill
#   cp .env.example .env
# NEVER commit .env (gitignored). Placeholders below are safe to commit.

# --- Solana RPC (public default, no secret) ---
RPC_URL=https://api.devnet.solana.com

# --- On-chain program IDs (HUMAN HANDOFF H1: fill after deploy) ---
# Local:  anchor deploy --provider.cluster devnet  → paste the two program IDs
# CI:     git tag deploy-YYYYMMDD && git push origin deploy-YYYYMMDD
#         → read target/deploy/devnet.env from the workflow artifact
ANCHOR_PROGRAM_ID=11111111111111111111111111111111
VAULT_PROGRAM_ID=11111111111111111111111111111111

# --- Agent keypair (HUMAN HANDOFF H2: generate once, devnet throwaway) ---
# Run: scripts/setup_credentials.sh  (generates + funds it, devnet only)
# Format: solana-keygen JSON array of 64 ints. NEVER reuse on mainnet.
AGENT_KEYPAIR_PATH=./agent_keypair.json
# NOTE: TS side reads KEYPAIR_PATH — meteora_executor.py sets it from
# AGENT_KEYPAIR_PATH automatically. Do NOT set KEYPAIR_PATH separately.

# --- Clawpump (HUMAN HANDOFF H3: paste from dashboard, bounty #2) ---
# Create at https://clawpump.tech/dashboard → key starts with cpk_
# Missing/placeholder = agent launch + earnings demo skipped (rest still runs).
CLAWPUMP_API_KEY=cpk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Nansen (Phase C only, optional today) ---
# API key from https://app.nansen.ai/api  (or leave placeholder for x402 micropayments later)
# Missing/placeholder = onchain_flow_signal stays neutral (demo-safe).
NANSEN_API_KEY=nansen_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Persisted risk counters (local state, not a secret) ---
RISK_STATE_PATH=./risk_state.json

# --- SOL price for USD→wSOL conversion in live swaps (Pyth feed is Phase C) ---
SOL_PRICE_USD=150.0

# --- Quote mint for DBC pools (devnet has no Circle USDC → wSOL) ---
# Devnet: wSOL So11111111111111111111111111111111111111112 (9dp, keeper threshold 10 SOL)
# Mainnet: USDC EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v (6dp, threshold 750 USDC)
QUOTE_MINT=So11111111111111111111111111111111111111112
QUOTE_DECIMALS=NINE

# --- Meteora DBC pools (HUMAN HANDOFF H4: fill after create_pool per symbol) ---
# node app/ts/dist/create_pool.js <base_mint> <config> <name> <symbol> <uri>
# Base mints resolve via xstocks.get_solana_mint (AAPLx, TSLAx, NVDAx).
DBC_POOL_AAPLX=PLACEHOLDER_POOL_PUBKEY
DBC_POOL_TSLAX=PLACEHOLDER_POOL_PUBKEY
DBC_POOL_NVDAX=PLACEHOLDER_POOL_PUBKEY
